{
  "name": "الهندسية المتحدة — الهوية والسوشيال",
  "version": "1.0.0",
  "status": "proposed-designer-handoff",
  "notes": [
    "ألوان التنفيذ مطابقة لاختيارات التطبيق ومتسقة بصريًا مع الشعار المرفق؛ ليست قيمًا مستخرجة من ملف شعار متجهي أصلي.",
    "المصدر المتاح للشعار JPG بخلفية سوداء؛ يلزم ملف أصلي شفاف أو متجهي لاعتماد وضع الشعار على خلفيات أخرى.",
    "رقما الهاتف من البوستات المرسلة ويجب تأكيدهما قبل النشر.",
    "الحدايق هو الموقع الوحيد المعروف. لا عنوان تفصيلي أو واتساب أو مدة ضمان معتمدة في هذا التسليم."
  ],
  "brand": {
    "name": "الهندسية المتحدة",
    "descriptor": "صيانة الأجهزة المنزلية",
    "location": "الحدايق",
    "logo": {
      "source": "./assets/brand-logo-original.jpg",
      "sourceFormat": "jpg",
      "background": "black",
      "preserveAspectRatio": true,
      "clearSpace": "0.125 * visibleArtworkWidth",
      "minimumRenderedWidth": "180px visible artwork at 1080px social canvas; exclude the JPG built-in black padding and check legibility after upload",
      "requiresOriginalExportFor": [
        "transparent background",
        "white/navy lockup",
        "one-color lockup",
        "uniform embroidery"
      ]
    },
    "contacts": {
      "reviewBeforePublishing": true,
      "source": "uploaded social posters",
      "phone1": "01016183923",
      "phone2": "01288845452",
      "whatsappConfirmed": false
    }
  },
  "color": {
    "brand": {
      "navy": {
        "$type": "color",
        "$value": "#000F50",
        "usage": "primary brand surface and headings"
      },
      "navyDark": {
        "$type": "color",
        "$value": "#000A38",
        "usage": "deep surface and footer"
      },
      "orange": {
        "$type": "color",
        "$value": "#F19301",
        "usage": "CTA and limited emphasis; navy text"
      }
    },
    "neutral": {
      "white": {
        "$type": "color",
        "$value": "#FFFFFF",
        "usage": "text on navy and plain backgrounds"
      },
      "surface": {
        "$type": "color",
        "$value": "#F6F7FB",
        "usage": "secondary surfaces"
      },
      "muted": {
        "$type": "color",
        "$value": "#4B5350",
        "usage": "secondary text on white/surface only"
      }
    },
    "rules": {
      "allowedPairs": [
        "white on navy",
        "navy on white",
        "navy on orange",
        "muted on white"
      ],
      "avoidPairs": [
        "white text on orange",
        "electric blue on navy",
        "white on lime"
      ],
      "emphasisLimit": "one orange focus per poster; neutral photography can contain natural colors"
    }
  },
  "typography": {
    "family": {
      "$type": "fontFamily",
      "$value": [
        "Cairo",
        "Tahoma",
        "Arial",
        "sans-serif"
      ]
    },
    "weights": {
      "body": 400,
      "subtitle": 600,
      "title": 700
    },
    "social1080": {
      "title": {
        "fontSizeMinPx": 84,
        "fontSizeMaxPx": 96,
        "fontWeight": 700,
        "lineHeight": 1.25,
        "maxLines": 2
      },
      "subtitle": {
        "fontSizePx": 48,
        "fontWeight": 600,
        "lineHeight": 1.4
      },
      "body": {
        "fontSizeMinPx": 36,
        "fontSizeMaxPx": 44,
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "contact": {
        "fontSizeMinPx": 44,
        "fontSizeMaxPx": 48,
        "fontWeight": 700,
        "lineHeight": 1.4,
        "direction": "ltr",
        "tabularNumbers": true
      },
      "caption": {
        "fontSizePx": 30,
        "fontWeight": 400,
        "lineHeight": 1.5,
        "importantContentAllowed": false
      }
    },
    "arabic": {
      "direction": "rtl",
      "manualKashida": false,
      "artificialTracking": false,
      "phonesInSeparateLtrFrames": true
    }
  },
  "layout": {
    "baseUnitPx": 8,
    "spacingPx": [
      8,
      16,
      24,
      32,
      48,
      64,
      96
    ],
    "social": {
      "primary": {
        "widthPx": 1080,
        "heightPx": 1350
      },
      "square": {
        "widthPx": 1080,
        "heightPx": 1080
      },
      "story": {
        "widthPx": 1080,
        "heightPx": 1920
      },
      "marginPx": 64,
      "columns": 6,
      "gutterPx": 24,
      "columnWidthPx": 138.666667,
      "gridStart": "right",
      "storySafeZone": {
        "topPx": 250,
        "bottomPx": 300,
        "verifyInPlatformPreview": true
      },
      "primaryFooter": {
        "yPx": 1126,
        "heightPx": 160,
        "bottomMarginPx": 64
      },
      "squareFooter": {
        "yPx": 856,
        "heightPx": 160,
        "bottomMarginPx": 64
      },
      "storyFooter": {
        "yPx": 1460,
        "heightPx": 160,
        "bottomSafePx": 300
      },
      "componentRadiusPx": 24
    }
  },
  "iconography": {
    "family": "one coherent outline icon set",
    "nominalSizePx": 24,
    "nominalStrokePx": 2,
    "socialSizePx": 72,
    "socialStrokePx": 6,
    "maximumBenefitsPerPoster": 3,
    "shape": "consistent round caps and joins; no mixing filled and outline symbols"
  },
  "content": {
    "oneMainTitle": true,
    "oneMainService": true,
    "oneMainImage": true,
    "oneCTA": true,
    "unverifiedClaims": [
      "خدمة سريعة",
      "ضمان على الخدمة",
      "صيانة جميع أنواع الأجهزة/السخانات"
    ],
    "requiredSpelling": [
      "فنيين",
      "على",
      "الهندسية المتحدة",
      "الحدايق"
    ]
  },
  "export": {
    "colorProfile": "sRGB",
    "formats": [
      "PNG for flat text-heavy artwork",
      "high-quality JPG for photography-heavy artwork"
    ],
    "reflowEachFormat": true,
    "doNotStretch": true,
    "delivery": [
      "editable source",
      "fonts or font links with license",
      "linked original photos and logo",
      "three format exports",
      "preview at mobile size"
    ]
  },
  "format": "project-specific JSON reference; no automatic Figma import or DTCG schema compliance claimed"
}
